# Copy to airflow/.env and fill in. Read by docker-compose.yaml.
# Never commit the filled-in file.

# --- Snowflake --------------------------------------------------------------
# These three also build AIRFLOW_CONN_SNOWFLAKE_DEFAULT, so the Airflow
# connection is created automatically at startup.
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=

# --- LLM --------------------------------------------------------------------
# NOTE: compose currently forwards OPENAI_API_KEY, but ai/enrich_reviews.py
# reads GEMINI_API_KEY. Set both until the image is rebuilt — see the
# "Known rough edges" section of the README.
GEMINI_API_KEY=
OPENAI_API_KEY=

# Reviews enriched per DAG run. Low by default to stay inside the free tier.
SAMPLE_N=5
