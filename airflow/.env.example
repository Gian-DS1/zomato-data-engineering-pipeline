# Copy to airflow/.env and fill in. Never commit the filled file.
# Read by docker-compose.yaml and passed through to the Airflow containers.

# Snowflake — used by dbt, the Airflow connection and the AI task
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_DATABASE=ZOMATO
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_WAREHOUSE=ZOMATO_WH

# Google Gemini — used by ai/enrich_reviews.py, which is mounted into the container
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Reviews sampled per enrichment run
SAMPLE_N=5
