# Copy to ai/.env and fill in. Never commit the filled-in file.

# --- Gemini -----------------------------------------------------------------
GEMINI_API_KEY=
# Optional; defaults to gemini-3.5-flash-lite if unset.
GEMINI_MODEL=gemini-3.5-flash-lite

# --- Snowflake --------------------------------------------------------------
# Account identifier, e.g. abcd-xy12345 (not the full URL).
SNOWFLAKE_ACCOUNT=
SNOWFLAKE_USER=
SNOWFLAKE_PASSWORD=
SNOWFLAKE_WAREHOUSE=ZOMATO_WH
SNOWFLAKE_DATABASE=ZOMATO
SNOWFLAKE_SCHEMA=STAGING
